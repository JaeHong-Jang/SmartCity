# Copy to apps/server/.env (never commit the real file). The key stays on the server.
ANTHROPIC_API_KEY=
# Optional: model for the AI building assistant (default claude-sonnet-5-5)
SC_AI_MODEL=claude-sonnet-5-5
# Optional: 1 = deterministic scripted assistant without any API call (tests / demos)
SC_AI_FAKE=0
